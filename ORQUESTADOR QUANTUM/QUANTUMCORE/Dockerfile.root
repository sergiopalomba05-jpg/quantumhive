FROM node:22-slim AS build
WORKDIR /app
COPY ["ORQUESTADOR QUANTUM/QUANTUMCORE/package.json", "ORQUESTADOR QUANTUM/QUANTUMCORE/package-lock.json", "./"]
RUN npm ci --legacy-peer-deps
COPY ["ORQUESTADOR QUANTUM/QUANTUMCORE/", "./"]
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/docs ./docs
COPY --from=build /app/package.json /app/package-lock.json ./
COPY ["graphify-out/graph.json", "./graphify-out/graph.json"]
COPY ["graphify-out/GRAPH_REPORT.md", "./graphify-out/GRAPH_REPORT.md"]
COPY ["graphify-out/manifest.json", "./graphify-out/manifest.json"]
COPY ["graphify-out/cost.json", "./graphify-out/cost.json"]
COPY ["agencia/productos/catalogo-pwa/", "./catalogo-pwa/"]
RUN npm ci --omit=dev --legacy-peer-deps

ENV NODE_ENV=production
ENV PORT=8080
ENV GRAPHIFY_PATH=/app/graphify-out/graph.json
ENV GRAPHIFY_STATIC_PATH=/app/graphify-out
ENV CATALOGO_PWA_STATIC_PATH=/app/catalogo-pwa
EXPOSE 8080

CMD ["node", "dist/server.cjs"]
